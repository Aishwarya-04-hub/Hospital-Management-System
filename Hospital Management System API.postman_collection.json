                "exec": [
                  "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Response body contains expected patient data\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"name\", \"Rahul Sharma\");\n    pm.expect(jsonData).to.have.property(\"email\", \"rahul.test@example.com\");\n    pm.expect(jsonData).to.have.property(\"_id\");\n});"
                ]
              }
